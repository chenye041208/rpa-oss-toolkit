# 阿里云 OSS 凭据模板：复制为同目录下的 .env 并填入真实值
#     cp .env.example .env
# 获取方式：阿里云控制台 → 右上角头像 → AccessKey 管理（建议使用 RAM 子账号）

# AccessKey ID
OSS_AK_ID=your_access_key_id

# AccessKey Secret
OSS_AK_SECRET=your_access_key_secret

# OSS 地域节点（以实际 Bucket 所在地域为准）
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com

# Bucket 名称
OSS_BUCKET=your_bucket_name
